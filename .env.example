# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Required from M3 on (classification, reports). Not needed for `db init`.
ANTHROPIC_API_KEY=

# SQLAlchemy URL. SQLite by default; a Postgres URL works too.
DATABASE_URL=sqlite:///data/review_intel.db

# Model choices (cheap + fast for bulk classification, stronger for prose).
CLASSIFY_MODEL=claude-haiku-5-5
REPORT_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-sonnet-5-5

# Path to the games config.
APPS_CONFIG_PATH=config/apps.yaml
